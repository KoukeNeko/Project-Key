#!/bin/sh
# The installer runs as root; the input method is registered and started in the console user's session.
user="$(stat -f %Su /dev/console)"
[ "$user" != root ] || exit 0
uid="$(id -u "$user")"
app="$(eval echo "~$user")/Library/Input Methods/ProjectKey.app"
pkill -x ProjectKey || true
launchctl asuser "$uid" sudo -u "$user" "$app/Contents/MacOS/ProjectKey" --register
launchctl asuser "$uid" sudo -u "$user" open -g "$app"
