<?xml version="1.0" encoding="UTF-8"?>
<!-- The Windows installer, built by build-msi.ps1 from the files of the release zip. It does what
     install.ps1 and uninstall.ps1 do, for every user of the machine. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Project Key" Manufacturer="KoukeNeko" Version="$(var.Version)" Language="1028" Codepage="65001"
           UpgradeCode="6F2E6C3A-3D0B-4B7E-9C55-1E7A4A0F9D21" Scope="perMachine" Compressed="yes">
    <SummaryInformation Description="Project Key 注音輸入法" />
    <MajorUpgrade Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="已安裝較新版本的 Project Key。" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="ProjectKey.ico" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="ProjectKey.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/KoukeNeko/Project-Key" />
    <!-- Open apps have the old files loaded: nothing here should close them or ask to. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Project Key" />
    </StandardDirectory>

    <Feature Id="Main" Title="Project Key">
      <Files Directory="INSTALLFOLDER" Include="$(var.Package)\**">
        <Exclude Files="$(var.Package)\install.ps1" />
        <Exclude Files="$(var.Package)\uninstall.ps1" />
        <Exclude Files="$(var.Package)\ProjectKey.dll" />
        <Exclude Files="$(var.Package)\ProjectKeyServer.exe" />
      </Files>
      <!-- Installed under other names and put in place by PutInPlace: open apps have the DLL loaded, and Windows
           Installer stops at a "files in use" dialog (InstallValidate) for any loaded file it owns. -->
      <Component Directory="INSTALLFOLDER" Id="TextServiceFile" Guid="3C5E1B7A-9D24-4F6B-8A13-6B2E9F4C7D01">
        <File Id="TextServiceNew" Source="$(var.Package)\ProjectKey.dll" Name="ProjectKey.dll.new" KeyPath="yes" />
      </Component>
      <Component Directory="INSTALLFOLDER" Id="ServerFile" Guid="A47D2C9E-1B83-4E5F-92C6-7F3A8D1E5B02">
        <File Id="ServerNew" Source="$(var.Package)\ProjectKeyServer.exe" Name="ProjectKeyServer.exe.new" KeyPath="yes" />
      </Component>
      <Component Directory="ProgramMenuFolder" Id="StartMenuShortcut" Guid="B0C3F3E2-8A44-4C39-8E1B-2D6F5A7C1E10">
        <!-- In the Start menu, so the settings open even when the keyboard list or its tray icon does not. -->
        <Shortcut Id="Settings" Name="Project Key" Description="Settings for the Project Key Zhuyin input method"
                  Target="[INSTALLFOLDER]Settings\ProjectKeySettings.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\ProjectKey" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Directory="INSTALLFOLDER" Id="ServerAtSignIn" Guid="7D1A9C54-2F6E-4E0A-A7B3-5C8E3F1D6A42">
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="ProjectKeyServer" Type="string"
                       Value="&quot;[INSTALLFOLDER]ProjectKeyServer.exe&quot;" KeyPath="yes" />
      </Component>
    </Feature>

    <!-- Before any file is removed, as the server has the models mapped: moves the running files aside (an open app
         restarts the server when it stops, and a loaded DLL cannot be replaced) and stops the server. Loaded ones stay
         as .old until a later install deletes them. Braces are escaped: in a formatted string, {...} is a conditional group. -->
    <SetProperty Id="MoveAside" Sequence="execute" Before="InstallInitialize"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$d='[INSTALLFOLDER]'; foreach ($n in 'ProjectKeyServer.exe','ProjectKey.dll') [\{] if (Test-Path -LiteralPath ($d+$n)) [\{] Move-Item -LiteralPath ($d+$n) ($d+$n+'.'+(New-Guid).ToString()+'.old') [\}] [\}]; Get-Process ProjectKeyServer,ProjectKeySettings -ErrorAction SilentlyContinue | Stop-Process -Force; Start-Sleep -Milliseconds 300; Get-ChildItem -LiteralPath $d -Filter *.old -ErrorAction SilentlyContinue | Remove-Item -Force -ErrorAction SilentlyContinue; exit 0&quot;" />
    <CustomAction Id="MoveAside" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="check" />

    <SetProperty Id="PutInPlace" Sequence="execute" Before="InstallInitialize"
                 Value="&quot;[System64Folder]cmd.exe&quot; /c move /y &quot;[INSTALLFOLDER]ProjectKey.dll.new&quot; &quot;[INSTALLFOLDER]ProjectKey.dll&quot; &amp;&amp; move /y &quot;[INSTALLFOLDER]ProjectKeyServer.exe.new&quot; &quot;[INSTALLFOLDER]ProjectKeyServer.exe&quot;" />
    <CustomAction Id="PutInPlace" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="check" />

    <SetProperty Id="Register" Sequence="execute" Before="InstallInitialize"
                 Value="&quot;[System64Folder]regsvr32.exe&quot; /s &quot;[INSTALLFOLDER]ProjectKey.dll&quot;" />
    <CustomAction Id="Register" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="check" />

    <SetProperty Id="Unregister" Sequence="execute" Before="InstallInitialize"
                 Value="&quot;[System64Folder]regsvr32.exe&quot; /u /s &quot;[INSTALLFOLDER]ProjectKey.dll&quot;" />
    <CustomAction Id="Unregister" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- As the signed-in user, after the elevated part: the server and the welcome window that adds the keyboard. -->
    <CustomAction Id="StartServer" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]ProjectKeyServer.exe&quot;"
                  Execute="immediate" Impersonate="yes" Return="asyncNoWait" />
    <CustomAction Id="Welcome" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]Settings\ProjectKeySettings.exe&quot; --welcome"
                  Execute="immediate" Impersonate="yes" Return="asyncNoWait" />

    <InstallExecuteSequence>
      <!-- Unregistering during an upgrade would take the keyboard out of every user's list. -->
      <Custom Action="Unregister" Before="MoveAside" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="MoveAside" Before="RemoveFiles" />
      <Custom Action="PutInPlace" After="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="Register" After="PutInPlace" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="StartServer" After="InstallFinalize" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="Welcome" After="StartServer" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND UILevel &gt; 2" />
    </InstallExecuteSequence>
  </Package>
</Wix>
