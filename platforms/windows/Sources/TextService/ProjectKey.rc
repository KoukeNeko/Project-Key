// The icon the input switcher shows (generated by build.ps1) and version information.
#include <winres.h>

1 ICON "ProjectKey.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,3,2,0
 PRODUCTVERSION 0,3,2,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040404b0"
    BEGIN
      VALUE "FileDescription", "Project Key 注音輸入法"
      VALUE "ProductName", "Project Key"
      VALUE "FileVersion", "0.3.2"
      VALUE "ProductVersion", "0.3.2"
      VALUE "LegalCopyright", "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0404, 1200
  END
END
