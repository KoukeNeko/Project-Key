#!/usr/bin/make -f
# Run through package-deb.sh, which puts this directory at the source root as debian/
# and fetches McBopomofo and the models first.

# The models' date and the McBopomofo commit: the data package changes only with them.
DATA_VERSION := $(shell echo $$(tr - . < tools/bigram-trainer/.cache/models-version.txt)+mcb$$(cut -c1-7 MCBOPOMOFO_COMMIT)-1)

%:
	dh $@ --buildsystem=cmake+ninja --sourcedirectory=platforms/linux

# PROJECTKEY_LLAMA, a llama.cpp checkout, builds in the advanced model (CMakeLists.txt).
override_dh_auto_configure:
	dh_auto_configure -- -DMCBOPOMOFO=$(CURDIR)/platforms/linux/build/mcbopomofo -DREQUIRE_MODELS=ON \
	  $(if $(PROJECTKEY_LLAMA),-DPROJECTKEY_LLAMA=$(PROJECTKEY_LLAMA))

override_dh_auto_test:
	for t in ComposerTest ControllerTest; do obj-*/$$t platforms/linux/build/mcbopomofo/Source/Data/data.txt || exit 1; done

override_dh_install:
	# The package manager's trigger refreshes it; a copy in the package conflicts with the system's.
	rm -f debian/tmp/usr/share/icons/hicolor/icon-theme.cache
	dh_install
	# The emoji change with the program, not with the models and McBopomofo that version the data
	# package: in that package, an update of them would never reach anyone.
	mkdir -p debian/fcitx5-projectkey/usr/share/fcitx5/projectkey
	mv debian/fcitx5-projectkey-data/usr/share/fcitx5/projectkey/emoji.txt debian/fcitx5-projectkey-data/usr/share/fcitx5/projectkey/EMOJI-NOTICE.txt \
	  debian/fcitx5-projectkey/usr/share/fcitx5/projectkey/

override_dh_gencontrol:
	dh_gencontrol -pfcitx5-projectkey -- -Vdata:Version=$(DATA_VERSION)
	dh_gencontrol -pfcitx5-projectkey-data -- -v$(DATA_VERSION)

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_builddeb:
	dh_builddeb -- -Zxz -z3
